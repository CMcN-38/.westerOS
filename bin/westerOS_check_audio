#!/usr/bin/env bash

# Check if any audio stream is currently playing (not paused/idle)
# Returns 0 (success) if audio is playing, 1 if not

# CellToSingularity.exe keeps a live, non-corked audio stream open even
# when idle in the background, so it is excluded here.
pw-dump 2>/dev/null | jq -e '
  [.[] | select(
    .info.props["media.class"]? == "Stream/Output/Audio"
    and .info.state == "running"
    and .info.props["application.name"]? != "CellToSingularity.exe"
  )]
  | length > 0
' >/dev/null
